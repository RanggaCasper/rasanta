# Example environment variables for Rasanta
APP_NAME=Rasanta
PORT=3000
HTTP_TIMEOUT_SECONDS=30
GOOGLE_MAPS_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.0.0 Safari/537.36
GOOGLE_MAPS_COOKIE_FILE=.secrets/google_maps_cookie.txt
# Optional fallback if not using file-based cookie:
# GOOGLE_MAPS_COOKIE=YOUR_GOOGLE_MAPS_COOKIE_HERE
